APP_NAME=AI Litigation & eDiscovery Analytics API
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
DATABASE_AUTO_CREATE_TABLES=true
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ediscovery
UPLOAD_DIR=storage/uploads
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=document_chunks
QDRANT_ENABLED=false
EMBEDDING_DIMENSION=384
OCR_ENABLED=false
OCR_PDF_TO_TEXT_COMMAND=
OCR_TIMEOUT_SECONDS=120
ENTITY_EXTRACTION_PROVIDER=deterministic
SPACY_MODEL=en_core_web_sm
GRAPH_CACHE_TTL_SECONDS=60
OPENAI_API_KEY=
AI_PROVIDER=local
AI_MODEL=gpt-4.1-mini
AI_EXTERNAL_ENABLED=false
AUTH_ENABLED=false
AUTH_BEARER_ENABLED=false
API_KEYS=
AUDIT_RETENTION_DAYS=365
AUDIT_PURGE_ON_STARTUP=false
LOG_LEVEL=INFO
STRUCTURED_LOGS=false
